---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  conversion?: boolean;
}

const {
  title,
  description = 'Perito de coches en Alicante. Especialista en siniestro total, vicios ocultos, reparaciones mal realizadas y peritaciones previas a la compra.',
  noindex = false,
  conversion = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = 'https://padillaperitaciones.com/img/logo-negro.png';

const schemaLocalBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://padillaperitaciones.com/#business",
  "name": "Padilla Peritaciones",
  "description": "Perito de vehículos en Alicante. Especialista en siniestro total, vicios ocultos, reparaciones mal realizadas y peritaciones previas a la compra.",
  "url": "https://padillaperitaciones.com",
  "telephone": "+34633979981",
  "email": "info@padillaperitaciones.com",
  "image": ogImage,
  "logo": ogImage,
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle Aspe, 7",
    "addressLocality": "Alicante",
    "postalCode": "03012",
    "addressRegion": "Alicante",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 38.3558006,
    "longitude": -0.4836483
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
      "opens": "09:00",
      "closes": "14:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "13",
    "bestRating": "5",
    "worstRating": "1"
  },
  "hasMap": "https://www.google.com/maps/place/?q=place_id:ChIJQ47yHPg3Yg0RB7WzPpYtLL8",
  "sameAs": [
    "https://www.google.com/maps/place/?q=place_id:ChIJQ47yHPg3Yg0RB7WzPpYtLL8"
  ],
  "areaServed": [
    { "@type": "City", "name": "Alicante" },
    { "@type": "City", "name": "Elche" },
    { "@type": "City", "name": "Benidorm" },
    { "@type": "City", "name": "Torrevieja" },
    { "@type": "City", "name": "Murcia" }
  ],
  "serviceType": [
    "Peritación de siniestro total",
    "Peritaje previo a compra de vehículo",
    "Peritación de reparación mal realizada",
    "Peritación de averías mecánicas",
    "Informe de vicios ocultos",
    "Valoración de daños en vehículos",
    "Perito judicial de vehículos"
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/img/logo-negro.png" />
  <link rel="apple-touch-icon" href="/img/logo-negro.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="Padilla Peritaciones" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Schema.org LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaLocalBusiness)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- gtag stub: las cargas reales se hacen tras consentimiento de cookies -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', 'G-TNR4HVND35');
    gtag('config', 'AW-622351073');
  </script>

  {conversion && (
    <script>
      gtag('event', 'conversion', {'send_to': 'AW-622351073/GS0ACIyAOtIbEOGl4agc'});
    </script>
  )}
</head>
<body>
  <main>
    <slot />
  </main>

  <!-- GDPR Cookie Banner -->
  <div id="cookie-banner" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;background:#0F2A45;color:white;padding:20px 24px;box-shadow:0 -4px 24px rgba(0,0,0,0.25)">
    <div style="max-width:1200px;margin:0 auto;display:flex;align-items:center;gap:24px;flex-wrap:wrap">
      <p style="flex:1;min-width:260px;font-size:14px;line-height:1.65;margin:0;color:rgba(255,255,255,0.88)">
        Usamos cookies propias y de terceros (Google Analytics, Google Ads) para analizar el uso del sitio y mostrarte publicidad relevante. Puedes aceptar todas o rechazarlas. Más información en nuestra <a href="/politica-de-cookies" style="color:#D4911A;text-decoration:underline">Política de Cookies</a> y <a href="/politica-de-privacidad" style="color:#D4911A;text-decoration:underline">Política de Privacidad</a>.
      </p>
      <div style="display:flex;gap:10px;flex-shrink:0;flex-wrap:wrap;align-items:center">
        <button onclick="cookieReject()" style="padding:10px 22px;border-radius:8px;border:1.5px solid rgba(255,255,255,0.35);background:transparent;color:white;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit">Rechazar</button>
        <button onclick="cookieAccept()" style="padding:10px 22px;border-radius:8px;border:none;background:#D4911A;color:white;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">Aceptar todo</button>
      </div>
    </div>
  </div>

  <script>
    // Header scroll behavior
    const header = document.getElementById('header');
    const scrollTopBtn = document.getElementById('scrollTopBtn');
    const headerBtn = document.getElementById('headerBtn');

    window.addEventListener('scroll', () => {
      const s = window.scrollY;
      if (header) header.classList.toggle('scrolled', s > 50);
      if (scrollTopBtn) scrollTopBtn.classList.toggle('visible', s > 400);
      if (headerBtn) headerBtn.style.display = s > 300 ? 'flex' : 'none';
    });

    // Reveal animations
    const reveals = document.querySelectorAll('.reveal');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(r => obs.observe(r));

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const t = document.querySelector(a.getAttribute('href'));
        if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      });
    });

    // Mobile nav
    function openMobileNav() {
      document.getElementById('mobileNav').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeMobileNav() {
      document.getElementById('mobileNav').classList.remove('open');
      document.body.style.overflow = '';
    }
    window.openMobileNav = openMobileNav;
    window.closeMobileNav = closeMobileNav;

    // Modal
    function closeModal() {
      const modal = document.getElementById('modal');
      if (modal) modal.classList.remove('open');
    }
    window.closeModal = closeModal;

    const modal = document.getElementById('modal');
    if (modal) modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

    // ── COOKIE CONSENT ──────────────────────────────────────────────────────
    function loadTrackingScripts() {
      var s1 = document.createElement('script');
      s1.async = true;
      s1.src = 'https://www.googletagmanager.com/gtag/js?id=G-TNR4HVND35';
      document.head.appendChild(s1);
      var s2 = document.createElement('script');
      s2.async = true;
      s2.src = 'https://www.googletagmanager.com/gtag/js?id=AW-622351073';
      document.head.appendChild(s2);
    }
    window.loadTrackingScripts = loadTrackingScripts;

    function cookieAccept() {
      localStorage.setItem('cookie_consent', 'accepted');
      var banner = document.getElementById('cookie-banner');
      if (banner) banner.style.display = 'none';
      loadTrackingScripts();
    }
    function cookieReject() {
      localStorage.setItem('cookie_consent', 'rejected');
      var banner = document.getElementById('cookie-banner');
      if (banner) banner.style.display = 'none';
    }
    window.cookieAccept = cookieAccept;
    window.cookieReject = cookieReject;

    var consent = localStorage.getItem('cookie_consent');
    if (!consent) {
      var banner = document.getElementById('cookie-banner');
      if (banner) banner.style.display = 'block';
    } else if (consent === 'accepted') {
      loadTrackingScripts();
    }

    // Form submit - envía a Google Sheets vía Apps Script
    async function handleSubmit(e) {
      e.preventDefault();
      const form = e.target;
      const btn = form.querySelector('button[type="submit"]');
      const original = btn.innerHTML;
      btn.innerHTML = 'Enviando...';
      btn.disabled = true;
      try {
        const data = {
          nombre: form.elements.nombre?.value || '',
          telefono: form.elements.telefono?.value || '',
          email: form.elements.email?.value || '',
          servicio: form.elements.servicio?.value || '',
          mensaje: form.elements.mensaje?.value || ''
        };
        const res = await fetch('https://formspree.io/f/xqedlvzw', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: new FormData(form)
        });
        if (!res.ok) throw new Error();
        window.location.href = '/gracias';
      } catch {
        alert('Ha ocurrido un error. Por favor llámanos al 633 97 99 81.');
        btn.innerHTML = original;
        btn.disabled = false;
      }
    }
    window.handleSubmit = handleSubmit;
  </script>
</body>
</html>
