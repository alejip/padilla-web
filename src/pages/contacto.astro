---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contacto | Perito de Coches en Alicante · Padilla Peritaciones"
  description="Contacta con el perito de coches en Alicante José Ángel Padilla. Solicita tu informe pericial o presupuesto sin compromiso. Respuesta en menos de 2 horas."
>

<Header activeService="/contacto" />

<!-- HERO -->
<section class="service-hero">
  <div class="hero-bg">
    <div class="grid-lines"></div>
    <div class="hero-glow glow-1"></div>
    <div class="hero-glow glow-2"></div>
  </div>
  <div class="container">
    <div class="service-hero-inner">
      <div class="reveal">
        <div class="breadcrumb">
          <a href="/">Inicio</a>
          <span class="breadcrumb-sep">/</span>
          <span class="breadcrumb-current">Contacto</span>
        </div>
        <div style="margin-bottom:18px"><span class="badge">Respuesta en &lt; 2 horas</span></div>
        <h1 class="service-hero-title">
          Cuéntanos<br />tu <span class="highlight">caso</span><br />sin compromiso
        </h1>
        <p class="service-hero-sub">Perito de coches en Alicante. Rellena el formulario o llámanos directamente. Te respondemos el mismo día laborable con orientación y presupuesto.</p>
        <div style="display:flex;flex-direction:column;gap:14px;margin-top:32px">
          <a href="tel:633979981" class="btn btn-primary btn-lg" style="width:fit-content">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.15-.75a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            633 97 99 81
          </a>
          <a href="tel:965247731" class="btn btn-secondary btn-lg" style="width:fit-content">
            965 24 77 31
          </a>
          <a href="https://wa.me/34633979981" target="_blank" class="btn btn-secondary btn-lg" style="width:fit-content;background:rgba(255,255,255,0.15)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.17.576 4.2 1.581 5.95L0 24l6.27-1.557A11.952 11.952 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.898 0-3.675-.5-5.22-1.378l-.37-.22-3.722.924.991-3.621-.241-.374A9.957 9.957 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
      <div class="mini-form-card reveal reveal-delay-2">
        <p class="mini-form-title">Solicitar presupuesto</p>
        <p class="mini-form-sub">Te respondemos hoy mismo en horario laboral</p>
        <form onsubmit="handleSubmit(event)">
          <input type="hidden" name="_subject" value="Nuevo Lead — Contacto" />
          <div class="form-group">
            <label>Nombre *</label>
            <input type="text" name="nombre" class="form-control" placeholder="Tu nombre" required />
          </div>
          <div class="form-group">
            <label>Teléfono *</label>
            <input type="tel" name="telefono" class="form-control" placeholder="6XX XXX XXX" required />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control" placeholder="tu@email.com" />
          </div>
          <div class="form-group">
            <label>Tipo de servicio</label>
            <select name="servicio" class="form-control">
              <option value="">Selecciona el tipo de peritaje...</option>
              <option>Perito Judicial</option>
              <option>Siniestro total</option>
              <option>Peritaje previo a compra</option>
              <option>Reparación mal realizada</option>
              <option>Avería mecánica</option>
              <option>Vicios ocultos</option>
              <option>Valoración de daños</option>
              <option>Otro</option>
            </select>
          </div>
          <button type="submit" class="btn btn-accent" style="width:100%;justify-content:center;margin-top:4px">Quiero que me llamen →</button>
          <p class="privacy-note">🔒 Sin compromiso. Respuesta en &lt;2h en horario laboral.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- FORMULARIO COMPLETO + DATOS -->
<section class="lead-section" id="formulario">
  <div class="container">
    <div class="lead-inner">
      <div class="lead-left reveal">
        <div style="margin-bottom:14px"><span class="badge">Datos de contacto</span></div>
        <h2 class="section-title">Estamos en Alicante</h2>
        <p class="section-subtitle">Atendemos en nuestra oficina y también nos desplazamos al vehículo en toda la provincia.</p>

        <div style="display:flex;flex-direction:column;gap:20px;margin-top:28px">
          <div style="display:flex;gap:14px;align-items:flex-start">
            <div style="width:42px;height:42px;border-radius:12px;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.15-.75a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <div style="font-weight:700;margin-bottom:4px">Teléfono</div>
              <a href="tel:633979981" style="color:var(--primary);text-decoration:none;font-size:15px">633 97 99 81</a><br />
              <a href="tel:965247731" style="color:var(--primary);text-decoration:none;font-size:15px">965 24 77 31</a>
            </div>
          </div>
          <div style="display:flex;gap:14px;align-items:flex-start">
            <div style="width:42px;height:42px;border-radius:12px;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <div style="font-weight:700;margin-bottom:4px">Email</div>
              <a href="mailto:info@padillaperitaciones.com" style="color:var(--primary);text-decoration:none;font-size:15px">info@padillaperitaciones.com</a>
            </div>
          </div>
          <div style="display:flex;gap:14px;align-items:flex-start">
            <div style="width:42px;height:42px;border-radius:12px;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <div style="font-weight:700;margin-bottom:4px">Dirección</div>
              <span style="font-size:15px;color:var(--text-muted)">Calle Aspe, 7 · 03012 Alicante</span>
            </div>
          </div>
          <div style="display:flex;gap:14px;align-items:flex-start">
            <div style="width:42px;height:42px;border-radius:12px;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <div style="font-weight:700;margin-bottom:4px">Horario</div>
              <span style="font-size:15px;color:var(--text-muted)">Lunes a jueves: 9:00 – 14:00</span>
            </div>
          </div>
        </div>

        <div style="margin-top:28px;border-radius:16px;overflow:hidden;border:1px solid rgba(15,42,69,0.12)">
          <iframe
            src="https://maps.google.com/maps?q=Calle+Aspe,+7,+03012+Alicante&output=embed"
            width="100%"
            height="260"
            style="border:0;display:block"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>

      <div class="lead-form reveal reveal-delay-2">
        <h3 style="font-size:20px;font-weight:700;margin-bottom:4px">Envíanos tu consulta</h3>
        <p style="font-size:13px;color:var(--text-muted);margin-bottom:22px">Respondemos hoy mismo en horario laboral</p>
        <form onsubmit="handleSubmit(event)">
          <input type="hidden" name="_subject" value="Nuevo Lead — Contacto" />
          <div class="form-row">
            <div class="form-group">
              <label>Nombre *</label>
              <input type="text" name="nombre" class="form-control" placeholder="Tu nombre completo" required />
            </div>
            <div class="form-group">
              <label>Email *</label>
              <input type="email" name="email" class="form-control" placeholder="tu@email.com" required />
            </div>
          </div>
          <div class="form-group">
            <label>Teléfono *</label>
            <input type="tel" name="telefono" class="form-control" placeholder="6XX XXX XXX" required />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control" placeholder="tu@email.com" />
          </div>
          <div class="form-group">
            <label>Tipo de servicio</label>
            <select name="servicio" class="form-control">
              <option value="">Selecciona el tipo de peritaje...</option>
              <option>Perito Judicial</option>
              <option>Siniestro total</option>
              <option>Peritaje previo a compra</option>
              <option>Reparación mal realizada</option>
              <option>Avería mecánica</option>
              <option>Vicios ocultos</option>
              <option>Valoración de daños</option>
              <option>Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label>Cuéntanos tu caso *</label>
            <textarea name="mensaje" class="form-control" placeholder="Describe brevemente la situación para que podamos orientarte mejor..." required></textarea>
          </div>
          <button type="submit" class="btn btn-accent" style="width:100%;justify-content:center;font-size:16px;padding:17px">Enviar consulta gratuita →</button>
          <p class="privacy-note">🔒 Tus datos están protegidos. Sin compromiso.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- SERVICIOS -->
<section class="related-services">
  <div class="container">
    <div class="section-header" style="margin-bottom:36px">
      <h2 class="section-title reveal">Nuestros servicios de peritación</h2>
    </div>
    <div class="services-row">
      <a href="/perito-judicial" class="service-chip reveal">
        <div class="service-chip-icon">⚖️</div>
        <div class="service-chip-name">Perito Judicial</div>
      </a>
      <a href="/siniestro-total" class="service-chip reveal reveal-delay-1">
        <div class="service-chip-icon">🚨</div>
        <div class="service-chip-name">Siniestro Total</div>
      </a>
      <a href="/antes-de-comprar" class="service-chip reveal reveal-delay-2">
        <div class="service-chip-icon">🔍</div>
        <div class="service-chip-name">Antes de Comprar</div>
      </a>
      <a href="/reparacion-mal-realizada" class="service-chip reveal reveal-delay-3">
        <div class="service-chip-icon">🔧</div>
        <div class="service-chip-name">Reparación Mal Realizada</div>
      </a>
      <a href="/vicios-ocultos" class="service-chip reveal reveal-delay-4">
        <div class="service-chip-icon">⚠️</div>
        <div class="service-chip-name">Vicios Ocultos</div>
      </a>
    </div>
  </div>
</section>

<Footer />

</Layout>
