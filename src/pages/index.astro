<script>
  // Header scroll
  const header = document.getElementById('header');
  const scrollTopBtn = document.getElementById('scrollTopBtn');
  const headerBtn = document.getElementById('headerBtn');
  window.addEventListener('scroll', () => {
    const s = window.scrollY;
    header.classList.toggle('scrolled', s > 50);
    scrollTopBtn.classList.toggle('visible', s > 400);
    headerBtn.style.display = s > 300 ? 'flex' : 'none';
  });

  // Mobile nav
  function openMobileNav() { document.getElementById('mobileNav').classList.add('open'); document.body.style.overflow='hidden'; }
  function closeMobileNav() { document.getElementById('mobileNav').classList.remove('open'); document.body.style.overflow=''; }
  window.openMobileNav = openMobileNav;
  window.closeMobileNav = closeMobileNav;

  // Reveal animation
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  reveals.forEach(r => observer.observe(r));

  // FAQ toggle
  function toggleFaq(el) {
    const isOpen = el.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
    if (!isOpen) el.classList.add('open');
  }
  window.toggleFaq = toggleFaq;

  // Form submit - envía a Google Sheets vía Apps Script
  async function handleSubmit(e) {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    const original = btn.innerHTML;
    btn.innerHTML = 'Enviando...'; btn.disabled = true;
    try {
      const data = {
        nombre: form.elements.nombre?.value || '',
        telefono: form.elements.telefono?.value || '',
        email: form.elements.email?.value || '',
        servicio: form.elements.servicio?.value || '',
        mensaje: form.elements.mensaje?.value || ''
      };
      const res = await fetch('https://formspree.io/f/xqedlvzw', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form)
      });
      if (!res.ok) throw new Error();
      window.location.href = '/gracias';
    } catch {
      alert('Ha ocurrido un error. Por favor llámanos al 633 97 99 81.');
      btn.innerHTML = original; btn.disabled = false;
    }
  }
  window.handleSubmit = handleSubmit;

  function closeModal() { document.getElementById('modal').style.display = 'none'; }
  window.closeModal = closeModal;
  document.getElementById('modal').addEventListener('click', function(e) { if(e.target===this) closeModal(); });

  // Counter animation
  function animateCounter(el, target, suffix) {
    let current = 0;
    const increment = target / 60;
    const timer = setInterval(() => {
      current += increment;
      if (current >= target) { current = target; clearInterval(timer); }
      el.textContent = Math.floor(current) + suffix;
    }, 25);
  }
  const statsSection = document.getElementById('stats');
  let counted = false;
  const statsObs = new IntersectionObserver((entries) => {
    if(entries[0].isIntersecting && !counted) {
      counted = true;
      document.querySelectorAll('.stat-number[data-target]').forEach(el => {
        const t = parseInt(el.dataset.target);
        animateCounter(el, t, '+');
      });
    }
  }, {threshold: 0.5});
  statsObs.observe(statsSection);

  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const t = document.querySelector(a.getAttribute('href'));
      if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });
</script>

