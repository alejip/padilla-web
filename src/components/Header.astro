---
interface Props {
  activeService?: string;
}

const { activeService } = Astro.props;

const services = [
  { label: 'Siniestro Total', href: '/siniestro-total' },
  { label: 'Antes de Comprar', href: '/antes-de-comprar' },
  { label: 'Reparación Mal Realizada', href: '/reparacion-mal-realizada' },
  { label: 'Averías Mecánicas', href: '/averias-mecanicas' },
  { label: 'Vicios Ocultos', href: '/vicios-ocultos' },
  { label: 'Valoración de Daños', href: '/valoracion-danos' },
  { label: 'Perito Judicial', href: '/perito-judicial' },
];

---

<style>
  /* ── PILL HEADER ── */
  #header { position:fixed;top:0;left:0;right:0;z-index:1000;padding:12px 0;transition:padding 0.4s ease; }
  #header .container { max-width:1440px; }
  #header.scrolled { padding:8px 0; }
  .header-inner { display:flex;align-items:center;justify-content:space-between;gap:12px;background:rgba(255,255,255,0.13);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,0.25);border-radius:60px;padding:8px 8px 8px 22px;transition:all 0.4s cubic-bezier(0.4,0,0.2,1); }
  #header.scrolled .header-inner { background:rgba(255,255,255,0.92);border-color:rgba(34,109,148,0.15);box-shadow:0 4px 28px rgba(34,109,148,0.13); }
  .logo img { height:36px;filter:brightness(0) invert(1);transition:height 0.3s,filter 0.4s; }
  #header.scrolled .logo img { height:32px;filter:none; }
  .main-nav { display:flex;align-items:center;gap:0; }
  .main-nav a { color:rgba(255,255,255,0.88);text-decoration:none;padding:7px 9px;border-radius:50px;font-size:12px;font-weight:500;transition:all 0.2s;white-space:nowrap; }
  .main-nav a:hover { color:white;background:rgba(255,255,255,0.15); }
  .main-nav a[aria-current="page"] { color:white;background:rgba(255,255,255,0.18);font-weight:600; }
  #header.scrolled .main-nav a { color:var(--text-muted); }
  #header.scrolled .main-nav a:hover { color:var(--primary);background:var(--primary-xlight); }
  #header.scrolled .main-nav a[aria-current="page"] { color:var(--primary);background:var(--primary-xlight); }
  .nav-sep { width:1px;height:14px;background:rgba(255,255,255,0.25);margin:0 6px;flex-shrink:0; }
  #header.scrolled .nav-sep { background:var(--border); }
  .header-cta { display:flex;align-items:center; }
  .presupuesto-btn { display:flex;align-items:center;background:var(--primary);color:white;text-decoration:none;padding:9px 18px;border-radius:50px;font-size:12px;font-weight:700;transition:all 0.2s;white-space:nowrap;border:none;cursor:pointer; }
  .presupuesto-btn:hover { background:var(--primary-dark);transform:translateY(-1px); }
  #header:not(.scrolled) .presupuesto-btn { background:rgba(255,255,255,0.95);color:var(--primary); }
  #header:not(.scrolled) .presupuesto-btn:hover { background:white; }
  .hamburger { display:none;background:none;border:none;cursor:pointer;padding:8px 10px;border-radius:50px;transition:background 0.2s; }
  .hamburger:hover { background:rgba(255,255,255,0.15); }
  #header.scrolled .hamburger:hover { background:var(--primary-xlight); }
  .hamburger span { display:block;width:20px;height:2px;background:white;margin:4px 0;transition:all 0.3s;border-radius:2px; }
  #header.scrolled .hamburger span { background:var(--text); }
  /* ── MOBILE NAV ── */
  .mobile-nav { display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:1001;background:rgba(255,255,255,0.96);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:24px; }
  .mobile-nav.open { display:flex; }
  .mobile-nav a { color:var(--text);text-decoration:none;font-size:15px;font-weight:700;padding:10px 28px;border-radius:50px;width:100%;max-width:320px;text-align:center;transition:all 0.2s;border:1.5px solid transparent; }
  .mobile-nav a:hover { color:var(--primary);background:var(--primary-xlight);border-color:rgba(34,109,148,0.2); }
  .mobile-nav-close { position:absolute;top:20px;right:20px;background:rgba(0,0,0,0.06);border:none;cursor:pointer;color:var(--text);font-size:16px;width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background 0.2s; }
  .mobile-nav-close:hover { background:rgba(34,109,148,0.1);color:var(--primary); }
  .mobile-nav-logo { margin-bottom:12px; }
  .mobile-nav-logo img { height:32px; }
  @media (max-width: 768px) {
    .main-nav { display:none; }
    .hamburger { display:block; }
    .header-cta { display:none; }
    .header-inner { backdrop-filter:none!important;-webkit-backdrop-filter:none!important; }
  }
</style>

<nav class="mobile-nav" id="mobileNav" aria-label="Menú móvil">
  <button class="mobile-nav-close" onclick="closeMobileNav()" aria-label="Cerrar menú">✕</button>
  <div class="mobile-nav-logo"><img src="/img/logo-negro.png" alt="Padilla Peritaciones" style="height:52px;width:auto" /></div>
  <a href="/" onclick="closeMobileNav()">Inicio</a>
  {services.map(s => (
    <a
      href={s.href}
      onclick="closeMobileNav()"
      style={s.href === activeService ? 'color:var(--primary);background:var(--primary-xlight)' : ''}
    >{s.label}</a>
  ))}
  <a href="/sobre-mi" onclick="closeMobileNav()" style={activeService === '/sobre-mi' ? 'color:var(--primary);background:var(--primary-xlight)' : ''}>Sobre mí</a>
  <a href="/contacto" onclick="closeMobileNav()" style={activeService === '/contacto' ? 'color:var(--primary);background:var(--primary-xlight)' : ''}>Contacto</a>
</nav>

<header id="header" role="banner">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo" aria-label="Padilla Peritaciones - Inicio">
        <img src="/img/logo-negro.png" alt="Padilla Peritaciones - Perito de coches en Alicante"
          onerror="this.style.display='none';this.nextElementSibling.style.display='block'" />
        <span style="display:none;font-family:'Plus Jakarta Sans',sans-serif;font-weight:900;font-size:18px;color:white;">PADILLA <span style="color:var(--accent)">PERITACIONES</span></span>
      </a>
      <nav class="main-nav" aria-label="Navegación principal" role="navigation">
        <a href="/" aria-current={!activeService ? 'page' : undefined}>Inicio</a>
        <span class="nav-sep"></span>
        {services.map(s => (
          <a href={s.href} aria-current={s.href === activeService ? 'page' : undefined}>{s.label}</a>
        ))}
        <span class="nav-sep"></span>
        <a href="/sobre-mi" aria-current={activeService === '/sobre-mi' ? 'page' : undefined}>Sobre mí</a>
        <a href="/contacto" aria-current={activeService === '/contacto' ? 'page' : undefined}>Contacto</a>
      </nav>
      <div class="header-cta">
        <a href="/contacto" class="presupuesto-btn">Presupuesto</a>
      </div>
      <button class="hamburger" onclick="openMobileNav()" aria-label="Abrir menú" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
