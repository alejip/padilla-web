<footer id="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-logo">
          <img src="/img/logo-negro.png" alt="Padilla Peritaciones"
            onerror="this.style.display='none';this.nextElementSibling.style.display='block'" />
