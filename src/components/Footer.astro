      <p>© 2026 Padilla Peritaciones · Todos los derechos reservados</p>
      <div class="footer-legal">
        <a href="#">Política de privacidad</a>
        <a href="#">Política de cookies</a>
        <a href="#">Aviso legal</a>
      </div>
    </div>
  </div>
</footer>

